{
  "name": "bonsai-sns-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "analyze": "ANALYZE=true npm run build",
    "build:deploy": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-pesticide": "npx tsx prisma/seed/pesticide/seed-pesticide-data.ts",
    "db:seed-pesticide-all": "npx tsx prisma/seed/pesticide/seed-pesticide-all.ts",
    "db:seed-pesticide-production": "node --env-file=.env.local scripts/call-seed-pesticide-api.mjs",
    "db:seed-production": "node --env-file=.env.local scripts/call-seed-api.mjs",
    "db:apply-migration-production": "node --env-file=.env.local scripts/call-apply-migration-api.mjs",
    "db:setup-fts": "npx tsx scripts/setup-fts.ts",
    "validate:pesticide": "npx tsx prisma/validation/export-pesticide-data.ts && npx tsx prisma/validation/validate-against-maff.ts",
    "validate:scrape-maff": "npx tsx prisma/validation/scrape-maff.ts",
    "validate:scrape-maff:dry": "npx tsx prisma/validation/scrape-maff.ts --dry-run",
    "generate:openapi": "npx tsx scripts/generate-openapi.ts",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner --maxWorkers=4",
    "test:ci": "vitest run --coverage --configLoader runner --maxWorkers=4",
    "test:e2e": "playwright test",
    "test:e2e:clean": "playwright test",
    "e2e:delete-test-users": "npx tsx scripts/delete-e2e-test-users.ts",
    "e2e:delete-production-users": "npx tsx scripts/delete-e2e-users-production.ts",
    "guest:delete-duplicate": "npx tsx scripts/delete-duplicate-guest-user.ts",
    "guest:delete-nickname": "npx tsx scripts/delete-guest-nickname-user.ts",
    "guest:seed": "npx tsx scripts/seed-guest-user.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "tutorial:pdf": "node scripts/convert-all-nomermaid-pdf.js",
    "tutorial:pdf:full": "node scripts/convert-tutorial-pdf.js",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.34.0",
    "@tanstack/react-query": "^5.90.16",
    "@types/leaflet": "^1.9.21",
    "@upstash/redis": "^1.36.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "^16.2.1",
    "next-auth": "5.0.0-beta.31",
    "otplib": "^13.2.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intersection-observer": "^10.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.6.0",
    "resend": "^6.7.0",
    "server-only": "^0.0.1",
    "stripe": "^20.1.2",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@next/bundle-analyzer": "^16.2.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "md-to-pdf": "^5.2.5",
    "prisma": "6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
