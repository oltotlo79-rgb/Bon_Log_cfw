  hormone HormoneType @relation(fields: [hormoneId], references: [id], onDelete: Cascade)

  @@index([hormoneId])
  @@map("hormone_effects")
}

model HormoneInteraction {
  id              String  @id @default(cuid())
  hormoneAId      String  @map("hormone_a_id")
