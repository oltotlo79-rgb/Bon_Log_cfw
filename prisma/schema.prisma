  pesticide        Pesticide @relation("IncompatibleWith", fields: [pesticideId], references: [id], onDelete: Cascade)
  incompatibleWith Pesticide @relation("IncompatibleBy", fields: [incompatibleWithId], references: [id], onDelete: Cascade)

  @@id([pesticideId, incompatibleWithId])
  @@index([incompatibleWithId])
  @@map("pesticide_incompatibilities")
}

