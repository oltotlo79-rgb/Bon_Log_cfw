model PesticideEffect {
  id               String        @id @default(cuid())
  pesticideId      String        @map("pesticide_id")
  diseasePestId    String        @map("disease_pest_id")
  preventionLevel  EffectRating? @map("prevention_level")
  treatmentLevel   EffectRating? @map("treatment_level")
  efficacyLevel    EffectRating? @map("efficacy_level")
  persistenceLevel EffectRating? @map("persistence_level")
  note             String?       @db.Text
