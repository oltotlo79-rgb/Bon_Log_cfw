  updatedAt        DateTime      @updatedAt @map("updated_at")

  pesticide   Pesticide   @relation(fields: [pesticideId], references: [id], onDelete: Cascade)
  diseasePest DiseasePest @relation(fields: [diseasePestId], references: [id], onDelete: Cascade)

  @@unique([pesticideId, diseasePestId])
  @@index([diseasePestId])
  @@map("pesticide_effects")
}

model PesticideIncompatibility {
