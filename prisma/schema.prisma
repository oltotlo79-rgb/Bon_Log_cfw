  @@index([userId])
  @@map("bonsais")
}

model BonsaiRecord {
  id        String   @id @default(cuid())
  bonsaiId  String   @map("bonsai_id")
  content   String?  @db.Text
  recordAt  DateTime @default(now()) @map("record_at")
  createdAt DateTime @default(now()) @map("created_at")

  bonsai Bonsai              @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)
  images BonsaiRecordImage[]

  @@index([bonsaiId])
  @@index([recordAt])
  @@map("bonsai_records")
}

model BonsaiRecordImage {
  id        String @id @default(cuid())
  recordId  String @map("record_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  record BonsaiRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("bonsai_record_images")
}

// 盆栽手入れログ（カレンダー表示用）。
// ユーザー全体に紐付く「忘れ防止メモ」で、特定の盆栽と関連付けない。
// 個別盆栽の手入れは BonsaiRecord（成長記録）側に書く想定。
// 表示はカレンダービュー専用で、タイムライン・盆栽詳細・公開プロフィール等には漏出させない。
model BonsaiCareLog {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  type        BonsaiCareType
  performedAt DateTime       @map("performed_at") // 実施日時（ユーザー入力）
  note        String?        @db.Text // 任意コメント
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // カレンダー主クエリ: userId + performedAt の範囲
  @@index([userId, performedAt])
  // 種別フィルタ: 任意の種別を絞って月次集計するケース
  @@index([userId, type, performedAt])
  @@map("bonsai_care_logs")
}

enum BonsaiCareType {
  pesticide // 消毒
  solid_fertilizer // 置き肥
  liquid_fertilizer // 液肥
  rotate // 移動・回転
  shading // 遮光
  muro_in // ムロ入れ
  muro_out // ムロ出し
  other // その他（将来の種別追加の受け皿）

  @@map("bonsai_care_type")
}

// ユーザーアナリティクス
model UserAnalytics {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  date          DateTime @db.Date
  profileViews  Int      @default(0) @map("profile_views")
  postViews     Int      @default(0) @map("post_views")
  likesReceived Int      @default(0) @map("likes_received")
  newFollowers  Int      @default(0) @map("new_followers")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("user_analytics")
}

/// 日次の実訪問者ログ。
///
/// `(date, visitorId)` の UNIQUE 制約により、同一訪問者が同日に複数回
/// アクセスしても 1 行のみ保持される（`POST /api/analytics/track` 側で
/// `INSERT ... ON CONFLICT DO NOTHING` 相当の upsert）。
///
/// `visitorId` は HttpOnly Cookie `bon_log_visitor_id` の UUID（個人特定不可な opaque ID）。
/// IP アドレスや User-Agent 等の PII は格納しない。`userId` はログイン中ならバックフィル
/// されるが任意。
model DailyVisitor {
  id        String   @id @default(cuid())
  date      DateTime @db.Date // 訪問日（UTC 起点）
  visitorId String   @map("visitor_id") @db.VarChar(64) // bon_log_visitor_id Cookie の UUID
  userId    String?  @map("user_id") // 認証時のみバックフィル
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([date, visitorId])
  @@index([date])
  @@index([userId])
  @@map("daily_visitors")
}

// メールアドレスブラックリスト
model EmailBlacklist {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?  @db.Text // ブロック理由（管理用メモ）
  createdBy String   @map("created_by") // 登録した管理者ID
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_blacklist")
}

// デバイスブラックリスト（フィンガープリントベース）
model DeviceBlacklist {
  id            String   @id @default(cuid())
  fingerprint   String   @unique // デバイスフィンガープリント（ハッシュ）
  reason        String?  @db.Text // ブロック理由
  originalEmail String?  @map("original_email") // 元のブロックユーザーのメール（参考用）
  createdBy     String   @map("created_by") // 登録した管理者ID
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("device_blacklist")
}

// ユーザーのデバイス履歴（デバイスフィンガープリント記録用）
model UserDevice {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  fingerprint String // デバイスフィンガープリント
  userAgent   String?  @map("user_agent") @db.Text
  ipAddress   String?  @map("ip_address")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
  @@map("user_devices")
}

// コメントスレッドミュート
model CommentThreadMute {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
