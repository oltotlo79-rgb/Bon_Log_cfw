model PollOption {
  id        String @id @default(cuid())
  pollId    String @map("poll_id")
  text      String @db.VarChar(50)
  sortOrder Int    @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}

// ============================================================
// 農薬・病害虫機能
// ============================================================

enum DiseasePestCategory {
  disease // 病害
  pest // 害虫
  beneficial_insect // 益虫
}

enum EffectRating {
  excellent // ◎
  good // ○
  fair // △
  poor // ×
  none // 効果なし（保護剤の治療など）
}

enum PesticideType {
  fungicide // 殺菌剤
  insecticide // 殺虫剤
  acaricide // 殺ダニ剤
  compound // 複合剤（殺虫殺菌剤等）
  other
}

model DiseasePest {
  id            String              @id @default(cuid())
  name          String              @db.VarChar(100)
  nameKana      String?             @map("name_kana") @db.VarChar(100)
  category      DiseasePestCategory
  description   String?             @db.Text
  imageUrl      String?             @map("image_url")
  slug          String              @unique
  sortOrder     Int                 @default(0) @map("sort_order")
  bodySizeMinMm Float?              @map("body_size_min_mm") // 体長最小値（mm）
  bodySizeMaxMm Float?              @map("body_size_max_mm") // 体長最大値（mm）
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  effects PesticideEffect[]

  @@index([category])
  @@map("disease_pests")
}

/// 耐性のつきやすさ（病原菌・害虫に耐性が発達しやすいか）
enum ResistanceRisk {
  low // つきにくい（多作用点・保護殺菌剤など）
  medium // ややつきやすい
  high // つきやすい（単一作用点など）
}

model ActiveIngredient {
  id              String          @id @default(cuid())
  name            String          @db.VarChar(200)
  nameEn          String?         @map("name_en") @db.VarChar(200)
  fracCode        String?         @map("frac_code") @db.VarChar(20)
  iracCode        String?         @map("irac_code") @db.VarChar(20)
  ingredientGroup String?         @map("ingredient_group") @db.VarChar(200)
  description     String?         @db.Text
  resistanceRisk  ResistanceRisk? @map("resistance_risk")
  slug            String          @unique
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  pesticides PesticideActiveIngredient[]

  @@index([fracCode])
  @@index([iracCode])
  @@map("active_ingredients")
}

model FormulationType {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(50)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pesticides Pesticide[]

  @@map("formulation_types")
}

model Pesticide {
  id                 String        @id @default(cuid())
  name               String        @db.VarChar(200)
  registrationNumber String?       @map("registration_number") @db.VarChar(20)
  pesticideType      PesticideType @map("pesticide_type")
  formulationTypeId  String?       @map("formulation_type_id")
  description        String?       @db.Text
  slug               String        @unique
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  formulationType  FormulationType?            @relation(fields: [formulationTypeId], references: [id], onDelete: SetNull)
  ingredients      PesticideActiveIngredient[]
  effects          PesticideEffect[]
  incompatibleWith PesticideIncompatibility[]  @relation("IncompatibleWith")
  incompatibleBy   PesticideIncompatibility[]  @relation("IncompatibleBy")
  spreaderTypes    PesticideSpreaderType[]     @relation("PesticideSpreaderTypes")

  @@index([registrationNumber])
  @@index([pesticideType])
  @@index([formulationTypeId])
  @@map("pesticides")
}

model PesticideActiveIngredient {
  pesticideId        String  @map("pesticide_id")
  activeIngredientId String  @map("active_ingredient_id")
  contentLabel       String? @map("content_label") @db.VarChar(100)

