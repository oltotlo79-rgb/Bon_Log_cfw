// ════════════════════════════════════════════════════════════
//  肥料ガイド — 栄養素・肥料分類・樹種・施肥計画・コラム
// ════════════════════════════════════════════════════════════

enum NutrientCategory {
  primary // 三大要素（N, P, K）
  secondary // 二次要素（Ca, Mg, S）
  trace // 微量要素（Fe, Mn, B, Zn, Cu, Mo, Cl, Ni, Si, Co）
}

enum TreeCategory {
  conifer // 松柏類
  deciduous // 雑木類（落葉樹）
  flowering // 花物
  fruiting // 実物
  grass // 草物・山野草
  evergreen // 常緑広葉樹
}

enum FertilizerAction {
  none // 施肥不要
  light // 控えめ
  moderate // 通常量
  heavy // たっぷり
}

enum NutrientLevel {
  high // 多め
  balanced // バランス
  low // 控えめ
  none // 不要
}

model FertilizerNutrient {
  id                 String           @id @default(cuid())
  name               String           @db.VarChar(100)
  nameEn             String?          @map("name_en")
  symbol             String           @db.VarChar(10)
  category           NutrientCategory
  description        String?          @db.Text
  bonsaiRole         String?          @map("bonsai_role") @db.Text
  deficiencySymptoms String?          @map("deficiency_symptoms") @db.Text
  excessSymptoms     String?          @map("excess_symptoms") @db.Text
  foodSources        String?          @map("food_sources") @db.Text
  slug               String           @unique
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("fertilizer_nutrients")
}

model FertilizerCategory {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  merit       String?  @db.Text
  demerit     String?  @db.Text
  bonsaiUsage String?  @map("bonsai_usage") @db.Text
  slug        String   @unique
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("fertilizer_categories")
}

model TreeSpecies {
  id                String       @id @default(cuid())
  name              String       @db.VarChar(100)
  nameEn            String?      @map("name_en")
  category          TreeCategory
  description       String?      @db.Text
  examples          String?      @db.Text
  fertilizingPolicy String?      @map("fertilizing_policy") @db.Text
  slug              String       @unique
  sortOrder         Int          @default(0) @map("sort_order")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  plans FertilizationPlan[]

  @@map("tree_species")
}

model FertilizationPlan {
  id              String           @id @default(cuid())
  treeSpeciesId   String           @map("tree_species_id")
  month           Int
  action          FertilizerAction
  nitrogenLevel   NutrientLevel?   @map("nitrogen_level")
  phosphorusLevel NutrientLevel?   @map("phosphorus_level")
  potassiumLevel  NutrientLevel?   @map("potassium_level")
  recommendedType String?          @map("recommended_type") @db.VarChar(50)
  description     String?          @db.Text
  cautionNote     String?          @map("caution_note") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  treeSpecies TreeSpecies @relation(fields: [treeSpeciesId], references: [id], onDelete: Cascade)

  @@unique([treeSpeciesId, month])
  @@index([treeSpeciesId])
  @@map("fertilization_plans")
}

model FertilizerColumn {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String    @db.VarChar(200)
  content     String    @db.Text
  category    String    @db.VarChar(50)
  publishedAt DateTime? @map("published_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("fertilizer_columns")
}

