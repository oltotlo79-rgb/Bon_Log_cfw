// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enum定義
// ============================================================

enum MediaType {
  image
  video
}

enum NotificationType {
  like
  comment
  follow
  quote
  reply
  comment_like
  follow_request
  follow_request_approved
  system
  mention
  message
  repost
  subscription_expiring
}

enum ReportTargetType {
  post
  comment
  event
  shop
  review
  user
}

enum ReportReason {
  spam
  inappropriate
  harassment
  copyright
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
  auto_hidden
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded
}

enum AdminRole {
  super_admin
  admin
  moderator
  support
  readonly
}

enum WarningLevel {
  notice
  warning
  temp_suspend
  permanent_ban
}

enum ModerationStatus {
  pending
  approved
  rejected
  auto_flagged
}

enum AnnouncementType {
  banner
  notification
  both
}

enum ContactStatus {
  pending
  in_progress
  resolved
  closed
}

enum GenreType {
  post
  shop
}

enum DevicePlatform {
  android
  ios
}

// NextAuth.js用モデル
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// パスワードリセットトークン
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, token])
  @@map("password_reset_tokens")
}

// メール確認用トークン（登録後のアドレス確認）
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, token])
  @@index([email])
  @@map("email_verification_tokens")
}

// ユーザー関連
model User {
  id               String    @id @default(cuid())
  email            String    @unique @db.VarChar(100)
  emailVerified    DateTime? @map("email_verified")
  password         String? // パスワードハッシュ
  nickname         String    @db.VarChar(50)
  avatarUrl        String?   @map("avatar_url")
  headerUrl        String?   @map("header_url")
  bio              String?   @db.VarChar(200)
  location         String?   @db.VarChar(100)
  bonsaiStartYear  Int?      @map("bonsai_start_year") // 盆栽を始めた年（任意）
  bonsaiStartMonth Int?      @map("bonsai_start_month") // 盆栽を始めた月（任意）
  birthDate        DateTime? @map("birth_date") @db.Date // 生年月日（任意）
  isPublic         Boolean   @default(true) @map("is_public")
  isSuspended      Boolean   @default(false) @map("is_suspended")
  suspendedAt      DateTime? @map("suspended_at")
  // プロフィール先頭に固定する自分の投稿（任意・1 件）。投稿削除時は SetNull で自動解除。
  pinnedPostId     String?   @map("pinned_post_id")
  // 初回オンボーディング完了日時。null は未完了（ログイン後に一度だけ /onboarding へ誘導する判定に使う）。
  onboardedAt      DateTime? @map("onboarded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // 有料会員
  isPremium            Boolean   @default(false) @map("is_premium")
  premiumExpiresAt     DateTime? @map("premium_expires_at")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")

  // 2段階認証（2FA）
  twoFactorEnabled     Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?  @map("two_factor_secret") // 暗号化されたTOTPシークレット
  twoFactorBackupCodes String[] @map("two_factor_backup_codes") // ハッシュ化されたバックアップコード

  // NextAuth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  posts                  Post[]
  pinnedPost             Post?              @relation("UserPinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)
  comments               Comment[]
  likes                  Like[]
  bookmarks              Bookmark[]
  followers              Follow[]           @relation("FollowingToUser")
  following              Follow[]           @relation("FollowerToUser")
  blockedBy              Block[]            @relation("BlockedUser")
  blocking               Block[]            @relation("BlockingUser")
  mutedBy                Mute[]             @relation("MutedUser")
  muting                 Mute[]             @relation("MutingUser")
  followRequestsSent     FollowRequest[]    @relation("FollowRequestSent")
  followRequestsReceived FollowRequest[]    @relation("FollowRequestReceived")
  notifications          Notification[]     @relation("NotificationUser")
  actorNotifications     Notification[]     @relation("NotificationActor")
  pushSubscriptions      PushSubscription[]
  shopReviews            ShopReview[]
  bonsaiShops            BonsaiShop[]
  events                 Event[]
  reports                Report[]

  // Admin
  adminUser AdminUser?

  // DM
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  // Premium
  scheduledPosts ScheduledPost[]
  payments       Payment[]

  // 下書き
  draftPosts DraftPost[]

  // 非表示投稿
  hiddenPosts UserHiddenPost[]

  // 盆栽
  bonsais Bonsai[]

  // 盆栽手入れログ（カレンダー表示用の構造化メモ、特定盆栽に紐付かない）
  careLogs BonsaiCareLog[]

  // 通知設定
  notificationPreferences Json? @default("{}") @map("notification_preferences")

  // 盆栽園変更リクエスト
  shopChangeRequests ShopChangeRequest[]

  // 天気アドバイス用位置情報
  weatherPrefecture String?  @map("weather_prefecture") @db.VarChar(10)
  weatherCity       String?  @map("weather_city") @db.VarChar(50)
  weatherLatitude   Decimal? @map("weather_latitude") @db.Decimal(8, 5)
  weatherLongitude  Decimal? @map("weather_longitude") @db.Decimal(9, 5)

  // アナリティクス
  analytics UserAnalytics[]

  // アンケート投票
  pollVotes PollVote[]

  // コメントスレッドミュート
  commentThreadMutes CommentThreadMute[]

  // 警告
  warnings UserWarning[]

  // 日次訪問ログ（認証時のみバックフィル）
  dailyVisits DailyVisitor[]

  // モバイル API v1 リフレッシュトークン
  refreshTokens RefreshToken[]

  // モバイル API v1 デバイストークン（Push 通知用）
  mobileDevices MobileDevice[]

  @@index([emailVerified])
  @@index([isSuspended])
  // 管理画面: ユーザー一覧のフィルタ + ソート最適化
  @@index([isSuspended, createdAt(sort: Desc)])
  // 投稿削除時の onDelete:SetNull (pinned_post_id) を seq scan させない
  @@index([pinnedPostId])
  @@map("users")
}

// 投稿関連
model Post {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  content      String?   @db.Text
  quotePostId  String?   @map("quote_post_id")
  repostPostId String?   @map("repost_post_id")
  bonsaiId     String?   @map("bonsai_id")
  // isHidden/hiddenAt: 管理者による非表示（モデレーション用）
  // ユーザーが投稿を削除した場合は物理削除（DB行削除）
  isHidden     Boolean   @default(false) @map("is_hidden")
  hiddenAt     DateTime? @map("hidden_at")
  // editedAt: 投稿後にユーザーが内容を編集した日時。null は未編集（UI の「編集済み」表示判定に使う）
  editedAt     DateTime? @map("edited_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotePost     Post?            @relation("QuotePost", fields: [quotePostId], references: [id], onDelete: SetNull)
  quotedBy      Post[]           @relation("QuotePost")
  repostPost    Post?            @relation("RepostPost", fields: [repostPostId], references: [id], onDelete: SetNull)
  repostedBy    Post[]           @relation("RepostPost")
  bonsai        Bonsai?          @relation(fields: [bonsaiId], references: [id], onDelete: SetNull)
  media         PostMedia[]
  genres        PostGenre[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  notifications Notification[]
  scheduledPost ScheduledPost?
  hashtags      PostHashtag[]
  hiddenByUsers UserHiddenPost[]
  poll          Poll?
  pinnedByUsers User[]           @relation("UserPinnedPost")

  @@index([userId])
  @@index([createdAt])
  @@index([isHidden])
  @@index([bonsaiId])
  @@index([quotePostId])
  @@index([repostPostId])
  // パフォーマンス最適化: タイムラインクエリ用の複合インデックス
  @@index([userId, isHidden, createdAt(sort: Desc)])
  // モデレーション用クエリの最適化
  @@index([isHidden, userId])
  // 同一ユーザーによる同一投稿への重複リポストを DB レベルで一意化する。
  // 通常投稿は repost_post_id IS NULL となり、Postgres は NULL を相異なる値として扱うため複数許容される。
  @@unique([userId, repostPostId])
  @@map("posts")
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  url       String
  type      MediaType
  sortOrder Int       @default(0) @map("sort_order")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model Genre {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(50)
  category  String    @db.VarChar(50)
  type      GenreType @default(post)
  sortOrder Int       @default(0) @map("sort_order")

  postGenres          PostGenre[]
  shopGenres          ShopGenre[]
  scheduledPostGenres ScheduledPostGenre[]
  draftPostGenres     DraftPostGenre[]

  @@unique([name, type])
  @@index([type])
  @@map("genres")
}

model PostGenre {
  postId  String @map("post_id")
  genreId String @map("genre_id")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([postId, genreId])
  @@index([genreId])
  @@map("post_genres")
}

// コメント
model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  parentId  String?   @map("parent_id")
  content   String    @db.Text
  // editedAt: 投稿後にユーザーが内容を編集した日時。null は未編集（UI の「編集済み」表示判定に使う）
  editedAt  DateTime? @map("edited_at")
  // isHidden/hiddenAt: 管理者による非表示（モデレーション用）
  // deletedAt: ユーザーによるソフト削除（論理削除）
  isHidden  Boolean   @default(false) @map("is_hidden")
  hiddenAt  DateTime? @map("hidden_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  post          Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]           @relation("CommentReplies")
  likes         Like[]
  media         CommentMedia[]
  notifications Notification[]
  threadMutes   CommentThreadMute[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  // コメント一覧クエリの最適化（created_at DESC含む複合インデックス）
  @@index([postId, parentId, isHidden, createdAt(sort: Desc)])
  // スレッド返信のページネーション最適化
  @@index([parentId, createdAt(sort: Desc)])
  @@map("comments")
}

// コメントメディア
model CommentMedia {
  id        String    @id @default(cuid())
  commentId String    @map("comment_id")
  url       String
  type      MediaType
  sortOrder Int       @default(0) @map("sort_order")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_media")
}

// いいね
//
// DB 制約: postId と commentId は「どちらか一方だけ必須」(XOR)。
// CHECK 制約 `likes_post_xor_comment` を migration 20260516000000_add_likes_check_constraint で
// 追加済み。Prisma schema には CHECK 制約を宣言する記法が無いため、変更時はこのコメントと
// migration の整合性を維持すること。
model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  commentId String?  @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([userId])
  @@index([commentId])
  // ページネーション最適化: getLikedPosts の ORDER BY created_at DESC
  @@index([userId, createdAt(sort: Desc)])
  @@map("likes")
}

// ブックマーク
model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  // ページネーション最適化: getBookmarkedPosts の ORDER BY created_at DESC
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

// フォロー
model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("FollowerToUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  // フォロワー一覧のページネーション最適化
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
  @@map("follows")
}

// ブロック
model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

// ミュート
model Mute {
  muterId   String   @map("muter_id")
  mutedId   String   @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at")

  muter User @relation("MutingUser", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutedUser", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
  @@map("mutes")
}

// フォローリクエスト（非公開アカウント用）
model FollowRequest {
  id          String        @id @default(cuid())
  requesterId String        @map("requester_id") // リクエスト送信者
  targetId    String        @map("target_id") // リクエスト受信者（非公開アカウント）
  status      RequestStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  requester User @relation("FollowRequestSent", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FollowRequestReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
  @@index([targetId, status])
  @@map("follow_requests")
}

// 通知
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  actorId   String           @map("actor_id")
  type      NotificationType
  postId    String?          @map("post_id")
  commentId String?          @map("comment_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
  // Note: @@unique([userId, actorId, type, postId, commentId]) は
  // nullable カラムを含むため PostgreSQL の NULL != NULL 動作で
  // postId=null の通知が重複可能。トランザクション内チェックで補完。
  // ページネーション最適化: getNotifications の ORDER BY created_at DESC
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  // 重複検出クエリ最適化: createNotification の findFirst
  @@index([userId, actorId, type, postId, commentId])
  @@map("notifications")
}

// 外部 Webhook の冪等性管理
//
// 同一 Webhook イベントが Stripe 等のリトライにより複数回到達しても
// 二重処理されないよう、provider 別に処理済み event_id を記録する。
// 古いレコードは `WEBHOOK_EVENT_RETENTION_DAYS`（30 日）経過後に
// cleanup-events Cron (`app/api/cron/cleanup-events/route.ts`) で削除する。
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @db.VarChar(50) // 'stripe' / 'paypal' など
  eventId     String   @map("event_id") @db.VarChar(255)
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

// プッシュ通知購読
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// 盆栽園
model BonsaiShop {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(100)
  address       String
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  phone         String?   @db.VarChar(20)
  website       String?
  businessHours String?   @map("business_hours")
  closedDays    String?   @map("closed_days")
  isHidden      Boolean   @default(false) @map("is_hidden")
  hiddenAt      DateTime? @map("hidden_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator        User?               @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  genres         ShopGenre[]
  reviews        ShopReview[]
  changeRequests ShopChangeRequest[]

  @@index([isHidden])
  @@index([createdBy])
  // location ソート最適化: getShops の ORDER BY latitude DESC NULLS LAST
  @@index([latitude(sort: Desc)])
  @@map("bonsai_shops")
}

model ShopGenre {
  shopId  String @map("shop_id")
  genreId String @map("genre_id")

  shop  BonsaiShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  genre Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([shopId, genreId])
  @@index([genreId])
  @@map("shop_genres")
}

model ShopReview {
  id        String    @id @default(cuid())
  shopId    String    @map("shop_id")
  userId    String    @map("user_id")
  rating    Int // 1-5
  content   String?   @db.Text
  isHidden  Boolean   @default(false) @map("is_hidden")
  hiddenAt  DateTime? @map("hidden_at")
  createdAt DateTime  @default(now()) @map("created_at")

  shop   BonsaiShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ShopReviewImage[]

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([isHidden])
  // 集計クエリ最適化: getCachedShopRatings の groupBy
  @@index([isHidden, shopId])
  @@map("shop_reviews")
}

model ShopReviewImage {
  id       String @id @default(cuid())
  reviewId String @map("review_id")
  url      String

  review ShopReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

