  hormoneB HormoneType @relation("hormoneB", fields: [hormoneBId], references: [id], onDelete: Cascade)

  @@unique([hormoneAId, hormoneBId])
  @@index([hormoneAId])
  @@index([hormoneBId])
  @@map("hormone_interactions")
}

model HormoneColumn {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String    @db.VarChar(200)
  content     String    @db.Text
  category    String    @db.VarChar(50)
  publishedAt DateTime? @map("published_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@map("hormone_columns")
}

model HormoneSeasonalLevel {
  id          String  @id @default(cuid())
  hormoneId   String  @map("hormone_id")
  month       Int // 1-12
  level       String  @db.VarChar(20) // high, moderate, low, minimal
  description String? @db.Text

  hormone HormoneType @relation(fields: [hormoneId], references: [id], onDelete: Cascade)

  @@unique([hormoneId, month])
  @@index([hormoneId])
  @@map("hormone_seasonal_levels")
}

model HormoneTechnique {
  id              String   @id @default(cuid())
  hormoneId       String   @map("hormone_id")
  techniqueName   String   @map("technique_name") @db.VarChar(50)
  techniqueNameEn String?  @map("technique_name_en") @db.VarChar(100)
  techniqueSlug   String   @map("technique_slug") @db.VarChar(50)
  effectType      String   @map("effect_type") @db.VarChar(20) // increase | decrease | redistribute
  magnitude       String   @db.VarChar(20) // strong | moderate | mild
  mechanism       String?  @db.Text
  practicalNote   String?  @map("practical_note") @db.Text
  bestMonths      Int[]    @default([]) @map("best_months")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  hormone HormoneType @relation(fields: [hormoneId], references: [id], onDelete: Cascade)

  @@unique([hormoneId, techniqueSlug])
  @@index([hormoneId])
  @@index([techniqueSlug])
  @@map("hormone_techniques")
}

// モバイル API v1 リフレッシュトークン
// 生トークンは保存せず SHA-256 ハッシュのみを保存することで DB 漏洩時のトークン再利用を防ぐ。
// revokedAt が null かつ expiresAt 未到来のものだけが有効。
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  userId      String    @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Phase 3: デバイス紐付け用予約カラム（現時点では未使用）
  deviceId    String?   @map("device_id")
  lastUsedAt  DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId + 有効判定（revokedAt IS NULL, expiresAt > now）でのクエリを高速化。
  // tokenHash は @unique で主検索に使う。userId インデックスは全失効操作向け。
  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

// モバイル Push 通知デバイストークン。
// token は Expo / APNs / FCM の Push トークン文字列。グローバル一意（端末の現所有者に紐付く）。
// 端末を譲渡・再インストールした場合、同じトークンを新 userId で upsert して付け替える。
model MobileDevice {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mobile_devices")
}
