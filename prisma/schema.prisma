// NGワード辞書（自動モデレーション用）
model NgWord {
  id        String   @id @default(cuid())
  word      String   @unique @db.VarChar(100)
  category  String   @db.VarChar(50) // spam, harassment, inappropriate
  isRegex   Boolean  @default(false) @map("is_regex")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("ng_words")
}

// 自動フラグされたコンテンツのモデレーションキュー
model ModerationQueue {
  id           String           @id @default(cuid())
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id")
  status       ModerationStatus @default(pending)
  reason       String           @db.Text
  matchedWords String[]         @map("matched_words")
  reviewedBy   String?          @map("reviewed_by")
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("moderation_queue")
}

// ユーザー警告
